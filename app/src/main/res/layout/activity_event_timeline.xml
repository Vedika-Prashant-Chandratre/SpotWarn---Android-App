<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/admindashboard"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_marginTop="120dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="🕉️ Kumbh Mela 2025 - Nashik Timetable"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Table Layout -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            android:background="#FFFFFFFF"
            android:padding="8dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <!-- Table Header -->
            <TableRow
                android:background="#FFCC80"
                android:padding="8dp">

                <TextView
                    android:text="Date"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:padding="8dp"
                    android:layout_weight="1"/>

                <TextView
                    android:text="Event"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:padding="8dp"
                    android:layout_weight="1"/>
            </TableRow>

            <!-- Row 1 -->
            <TableRow android:background="#FFF8E1">
                <TextView
                    android:text="13 Jan 2025"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:text="Paush Purnima Snan"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <!-- Row 2 -->
            <TableRow android:background="#E8F5E9">
                <TextView
                    android:text="29 Jan 2025"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:text="Maagh Amavasya Snan"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <!-- Row 3 -->
            <TableRow android:background="#E3F2FD">
                <TextView
                    android:text="12 Feb 2025"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:text="Basant Panchami Snan"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <!-- Row 4 -->
            <TableRow android:background="#F3E5F5">
                <TextView
                    android:text="26 Feb 2025"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:text="Magh Purnima Snan"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <!-- Row 5 -->
            <TableRow android:background="#FCE4EC">
                <TextView
                    android:text="14 Mar 2025"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:text="Maha Shivratri Snan"
                    android:padding="8dp"
                    android:textColor="@android:color/black"/>
            </TableRow>
        </TableLayout>

    </LinearLayout>
</ScrollView>
